<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_school" model="ir.module.category">
        <field name="name">School</field>
    </record>

    <record id="group_school_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_school_manager" model="res.groups">
        <field name="name">School Manager</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[Command.link(ref('group_school_teacher'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <record id="rule_school_class_teacher" model="ir.rule">
            <field name="name">Teacher: own classes</field>
            <field name="model_id" ref="model_school_class"/>
            <field name="domain_force">[('teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_teacher'))]"/>
        </record>

        <record id="rule_school_student_teacher" model="ir.rule">
            <field name="name">Teacher: students of own classes</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('class_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_teacher'))]"/>
        </record>

        <record id="rule_school_enrollment_teacher" model="ir.rule">
            <field name="name">Teacher: enrollments of own classes</field>
            <field name="model_id" ref="model_school_enrollment"/>
            <field name="domain_force">[('student_id.class_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_teacher'))]"/>
        </record>

        <record id="rule_school_class_manager" model="ir.rule">
            <field name="name">School Manager: all classes</field>
            <field name="model_id" ref="model_school_class"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_manager'))]"/>
        </record>

        <record id="rule_school_student_manager" model="ir.rule">
            <field name="name">School Manager: all students</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_manager'))]"/>
        </record>

        <record id="rule_school_enrollment_manager" model="ir.rule">
            <field name="name">School Manager: all enrollments</field>
            <field name="model_id" ref="model_school_enrollment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_school_manager'))]"/>
        </record>

    </data>

</odoo>
