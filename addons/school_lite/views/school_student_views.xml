<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="school_student_view_list" model="ir.ui.view">
        <field name="name">school.student.view.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="birth_date" optional="show"/>
                <field name="age" optional="show"/>
                <field name="guardian_name" optional="hide"/>
                <field name="guardian_phone" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'enrolled'"
                       decoration-muted="state in ('graduated', 'withdrawn')"/>
            </list>
        </field>
    </record>

    <record id="school_student_view_form" model="ir.ui.view">
        <field name="name">school.student.view.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enroll" type="object" string="Enroll" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,graduated"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sara Ahmed"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Student">
                            <field name="code"/>
                            <field name="class_id"/>
                            <field name="birth_date"/>
                            <field name="age" invisible="not birth_date"/>
                        </group>
                        <group string="Guardian">
                            <field name="guardian_name"/>
                            <field name="guardian_phone" widget="phone"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="school_student_view_kanban" model="ir.ui.view">
        <field name="name">school.student.view.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="class_id">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="code" class="text-muted"/>
                        <field name="state" widget="badge"
                               decoration-info="state == 'draft'"
                               decoration-success="state == 'enrolled'"
                               decoration-muted="state in ('graduated', 'withdrawn')"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="school_student_view_search" model="ir.ui.view">
        <field name="name">school.student.view.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="class_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_enrolled" string="Enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter name="filter_graduated" string="Graduated" domain="[('state', '=', 'graduated')]"/>
                <filter name="filter_withdrawn" string="Withdrawn" domain="[('state', '=', 'withdrawn')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="school_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
