<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="school_class_enroll_wizard_view_form" model="ir.ui.view">
        <field name="name">school.class.enroll.wizard.view.form</field>
        <field name="model">school.class.enroll.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="class_id"/>
                    <field name="subject_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_enroll_class" type="object" string="Enroll" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="school_class_enroll_wizard_action" model="ir.actions.act_window">
        <field name="name">Enroll Class in Subject</field>
        <field name="res_model">school.class.enroll.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
